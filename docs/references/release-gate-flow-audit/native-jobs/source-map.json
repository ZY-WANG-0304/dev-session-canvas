    "scripts/build/windows-execution-candidate-assets.mjs": "1c0a3773f981c3c63fa3b632b08d5e2966175bbb8dfa8a3b9600bf00ef8e74bc",
    "scripts/build/linux-execution-elf.mjs": "19d5532e1ba85e4010ad3d211e2ff75b6ac7eb22e1e4caa1b41d95f8c0d490d3",
