+async function rcaCapture(label) {
+  const value = { label, pid: process.pid, workspaceFolders: vscode.workspace.workspaceFolders?.map(folder => folder.uri.fsPath), snapshot: await getDebugSnapshot(), events: await getDiagnosticEvents(),
+    errors: (await getHostMessages()).filter(message => message.type === 'host/error') };
+  await fs.mkdir('/tmp/dscr/.debug/rca', { recursive: true });
+  await fs.writeFile(`/tmp/dscr/.debug/rca/${label}.json`, JSON.stringify(value, null, 2));
+  console.log('RCA_CAPTURE', label, JSON.stringify(value.snapshot.investigation));
+  return value.snapshot;
+}
+
+async function runReloadInvestigation() {
+  const mode = process.env.DSC_RELOAD_RCA;
+  await vscode.commands.executeCommand(COMMAND_IDS.openCanvasInEditor);
+  await vscode.commands.executeCommand(COMMAND_IDS.testWaitForCanvasReady, 'editor', 20000);
+  const ids = {};
+  // Serialize creation to isolate state replacement from initial concurrent admission.
+  for (const kind of ['agent', 'terminal', 'note']) {
+    await dispatchWebviewMessage({ type: 'webview/createDemoNode', payload: { kind } });
+    ids[kind] = findNodeByKind(await getDebugSnapshot(), kind).id;
+    if (kind === 'agent') await waitForAgentLive(ids.agent);
+    if (kind === 'terminal') await waitForTerminalLive(ids.terminal);
+  }
+  const before = await rcaCapture(`${mode}-before`);
+  assert(before.investigation.records.every(record => record.metadataMatches));
+  if (mode === 'seed') await setPersistedState(before.state);
+  else if (mode === 'reload') await reloadPersistedState();
+  else if (mode === 'sidebar') await verifySidebarNodeList(ids.agent, ids.terminal, ids.note);
+  else if (mode === 'workspace-add') {
+    await fs.mkdir('/tmp/dscr-added-root', { recursive: true });
+    const changed = new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { listener.dispose(); reject(new Error('No workspace folders event')); }, 15000);
+      const listener = vscode.workspace.onDidChangeWorkspaceFolders(event => {
+        if (event.added.some(folder => folder.uri.fsPath === '/tmp/dscr-added-root')) {
+          clearTimeout(timer); listener.dispose(); resolve();
+        }
+      });
+    });
+    assert(vscode.workspace.updateWorkspaceFolders(vscode.workspace.workspaceFolders.length, 0,
+      { uri: vscode.Uri.file('/tmp/dscr-added-root'), name: 'RCA additional root' }));
+    await changed;
+  }
+  else if (mode === 'boundary') {
+    try { await vscode.commands.executeCommand(COMMAND_IDS.testSimulateRuntimeReload); }
+    catch (error) {
+      await rcaCapture('boundary-first-rejection');
+      console.log('RCA_BOUNDARY_FIRST_ERROR', String(error));
+      if (!/Local final snapshot persistence is pending/.test(String(error))) throw error;
+      await waitForSnapshot(snapshot => snapshot.investigation.records.length === 0);
+      await rcaCapture('boundary-final-saved');
+      await vscode.commands.executeCommand(COMMAND_IDS.testSimulateRuntimeReload);
+    }
+  }
+  else if (mode === 'control') {
+    await dispatchWebviewMessage({ type: 'webview/updateNodeTitle', payload: { nodeId: ids.agent, title: 'RCA control' } });
+    await dispatchWebviewMessage({ type: 'webview/moveNode', payload: { id: ids.agent, position: { x: 160, y: 140 } } });
+    await vscode.commands.executeCommand(COMMAND_IDS.openCanvasInPanel);
+    await vscode.commands.executeCommand(COMMAND_IDS.testWaitForCanvasReady, 'panel', 20000);
+    await vscode.commands.executeCommand(COMMAND_IDS.openCanvasInEditor);
+    await vscode.commands.executeCommand(COMMAND_IDS.testWaitForCanvasReady, 'editor', 20000);
+  }
+  await rcaCapture(`${mode}-immediate`);
+  if (mode === 'boundary') {
+    for (const kind of ['agent', 'terminal']) {
+      await dispatchWebviewMessage({ type: 'webview/startExecutionSession', payload: { kind, nodeId: ids[kind], cols: 80, rows: 24 } });
+      if (kind === 'agent') await waitForAgentLive(ids.agent);
+      else await waitForTerminalLive(ids.terminal);
+    }
+  }
+  await new Promise(resolve => setTimeout(resolve, 2000));
+  const after = await rcaCapture(`${mode}-after`);
+  if (mode === 'control') {
+    await verifyAutoStartOnCreate(ids.agent, ids.terminal);
+    assert(after.investigation.records.every(record => record.metadataMatches && !record.mutationError));
+  } else if (['seed','reload','sidebar','workspace-add'].includes(mode)) {
+    assert(after.investigation.records.some(record => !record.metadataMatches));
+    assert(after.investigation.records.some(record => !record.execution.retired));
+  }
+}
