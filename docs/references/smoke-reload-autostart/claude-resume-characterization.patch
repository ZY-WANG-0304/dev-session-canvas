+for (const filePresent of [true, false]) {
+  test(`RCA Claude file confirmation with filePresent=${filePresent}`, async () => {
+    const taskHome = await mkdtemp(path.join(os.tmpdir(), 'dsc-claude-confirm-'));
+    const id = 'session-explicit-123456789';
+    const cwd = '/controlled';
+    testClaudeLocator.env = { HOME: taskHome };
+    testClaudeLocator.calls = [];
+    const f = candidateFixture();
+    delete f.host.resolveAgentResumeContext;
+    f.host.state.nodes.find(node => node.id === 'agent-1').metadata.agent = { provider: 'claude' };
+    f.host.resolveAgentFreshLaunch = () => ({ commandLine: `claude --session-id=${id}`,
+      requestedCommand: 'claude', launchArgs: [`--session-id=${id}`], launchPreset: 'custom' });
+    f.host.getRequestedAgentCliSpec = CanvasPanelManager.prototype.getRequestedAgentCliSpec;
+    f.host.resolveAgentCli = async () => ({ command: '/controlled/claude', provider: 'claude' });
+    let record;
+    try {
+      if (filePresent) {
+        const dir = path.join(taskHome, '.claude', 'projects', '-controlled');
+        await mkdir(dir, { recursive: true });
+        await writeFile(path.join(dir, `${id}.jsonl`), '{}\n');
+      }
+      assert.equal(await locateClaudeSessionId({ cwd, sessionId: id }), filePresent ? id : null);
+      testClaudeLocator.calls = [];
+      await completed(f.clock, f.host.startAgentSession('agent-1', 80, 24, 'claude', false), 'RCA Claude started');
+      record = f.record('agent');
+      const identity = record.execution.identity;
+      f.providers[0].output(1, '> ');
+      await until(f.clock, () => record.execution.snapshot().adapter.consumedThrough === 1, 'RCA Claude prompt consumed');
+      f.clock.advance(300);
+      assert.equal(record.business.lifecycleStatus, 'waiting-input');
+      assert.deepEqual(record.business.agentResume, { supported: false, strategy: 'none', sessionId: id });
+      assert.equal(testClaudeLocator.calls.length, 0, 'actual owned startup and waiting-input never invoke the file locator');
+      assert.equal(f.host.agentSessions.size, 0);
+      const legacyShape = { ...record.business, cwd, startedAtMs: 0 };
+      await f.host.maybeConfirmClaudeResumeSessionId('agent-1', legacyShape, 'startup');
+      assert.equal(testClaudeLocator.calls.length, 1);
+      assert.equal(testClaudeLocator.calls[0].result, filePresent ? id : null);
+      assert.equal(legacyShape.agentResume.strategy, 'none', 'old helper rejects a session absent from the legacy map even when file lookup succeeds');
+      let flushes = 0;
+      f.host.flushLiveExecutionState = () => { flushes++; };
+      f.host.agentSessions.set('agent-1', legacyShape);
+      await f.host.maybeConfirmClaudeResumeSessionId('agent-1', legacyShape, 'startup');
+      assert.equal(legacyShape.agentResume.strategy, filePresent ? 'claude-session-id' : 'none');
+      assert.equal(flushes, filePresent ? 1 : 0);
+      f.host.agentSessions.delete('agent-1');
+      // Control only: transfer the same locator-confirmed result through the actual owned projection.
+      if (filePresent) {
+        record.business.agentResume = { ...legacyShape.agentResume };
+        f.host.projectNonNativeHostBusiness(record);
+      }
+      const metadata = f.host.state.nodes.find(node => node.id === 'agent-1').metadata.agent;
+      assert.equal(metadata.resumeStrategy, filePresent ? 'claude-session-id' : 'none');
+      assert.equal(metadata.resumeSupported, filePresent);
+      assert.equal(metadata.resumeSessionId, id);
+      assert.strictEqual(record.execution.identity, identity);
+      assert.equal(record.execution.snapshot().stopRequested, false);
+      console.log('RCA Claude host:', JSON.stringify({ filePresent, identity,
+        normalOwnedLocatorCalls: 0, oldHelperWithOwnedRecord: 'no promotion',
+        legacyControl: legacyShape.agentResume, ownedProjectionControl: {
+          resumeStrategy: metadata.resumeStrategy, resumeSupported: metadata.resumeSupported, resumeSessionId: metadata.resumeSessionId } }));
+    } finally {
+      f.host.agentSessions.clear();
+      if (record) await disposeStartedCandidate(f, 'agent');
+      await rm(taskHome, { recursive: true, force: true });
+    }
+  });
+}
