{
  "name": "@dev-session-canvas/marketplace-shared",
  "private": true,
  "version": "0.1.0",
  "description": "Shared types and seed data for the Dev Session Canvas template marketplace.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "vitest": "^3.2.4"
  },
  "typesVersions": {
    "*": {
      "schema": [
        "./src/schema.ts"
      ]
    }
  }
}
