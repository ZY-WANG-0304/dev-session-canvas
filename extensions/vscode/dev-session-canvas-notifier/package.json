{
  "name": "dev-session-canvas-notifier",
  "displayName": "Dev Session Canvas Notifier",
  "description": "在本机 UI 侧为 Dev Session Canvas 投递桌面系统通知的 companion extension。",
  "version": "0.21.1",
  "publisher": "devsessioncanvas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas.git"
  },
  "homepage": "https://github.com/ZY-WANG-0304/dev-session-canvas",
  "bugs": {
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas/issues"
  },
  "licenseUrl": "https://github.com/ZY-WANG-0304/dev-session-canvas/blob/main/LICENSE",
  "privacyUrl": "https://github.com/ZY-WANG-0304/dev-session-canvas/blob/main/PRIVACY.md",
  "api": "none",
  "preview": true,
  "icon": "images/icon.png",
  "extensionDependencies": [
    "devsessioncanvas.dev-session-canvas"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "dist/**",
    "images/**",
    "CHANGELOG.md",
    "LICENSE",
    "README.marketplace.md",
    "package.json"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:devSessionCanvasNotifier.status",
    "onView:devSessionCanvasNotifier.notes",
    "onView:devSessionCanvasNotifier.macOS",
    "onView:devSessionCanvasNotifier.linux",
    "onView:devSessionCanvasNotifier.windows",
    "onView:devSessionCanvasNotifier.codex",
    "onView:devSessionCanvasNotifier.claudeCode",
    "onCommand:devSessionCanvasNotifier.postSystemNotification",
    "onCommand:devSessionCanvasNotifier.sendTestNotification",
    "onCommand:devSessionCanvasNotifier.openDiagnosticOutput",
    "onCommand:devSessionCanvasNotifier.openSettings",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devSessionCanvasNotifier",
          "title": "Dev Session Canvas Notifier",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "devSessionCanvasNotifier": [
        {
          "id": "devSessionCanvasNotifier.status",
          "name": "概览",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.notes",
          "name": "注意事项",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.macOS",
          "name": "macOS",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.linux",
          "name": "Linux",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.windows",
          "name": "Windows",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.codex",
          "name": "Codex",
          "type": "webview"
        },
        {
          "id": "devSessionCanvasNotifier.claudeCode",
          "name": "Claude Code",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "devSessionCanvasNotifier.openSettings",
          "when": "view == devSessionCanvasNotifier.status",
          "group": "navigation@99"
        }
      ]
    },
    "commands": [
      {
        "command": "devSessionCanvasNotifier.sendTestNotification",
        "title": "Dev Session Canvas Notifier: 发送测试桌面通知"
      },
      {
        "command": "devSessionCanvasNotifier.openDiagnosticOutput",
        "title": "Dev Session Canvas Notifier: 打开通知诊断输出"
      },
      {
        "command": "devSessionCanvasNotifier.openSettings",
        "title": "Dev Session Canvas Notifier: 打开配置",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "Dev Session Canvas Notifier",
      "properties": {
        "devSessionCanvasNotifier.notifications.playSound": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "控制 notifier companion 在当前本机 UI 侧投递桌面通知时，是否请求系统播放提示音。关闭后会尽量走静音路径；实际是否完全静音取决于平台后端与系统通知服务。"
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "package": "npm run typecheck && node ./scripts/build.mjs --production",
    "package:vsix": "npm run package && node ./scripts/package-vsix.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "vscode:prepublish": "npm run package"
  }
}
