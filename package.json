{
  "name": "dev-session-canvas",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.8.0",
  "workspaces": [
    "extensions/vscode/dev-session-canvas-notifier",
    "packages/attention-protocol"
  ],
  "publisher": "devsessioncanvas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas.git"
  },
  "homepage": "https://github.com/ZY-WANG-0304/dev-session-canvas",
  "bugs": {
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas/issues"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "canvas",
    "workbench",
    "multi-agent",
    "terminal",
    "note",
    "collaboration",
    "画布",
    "协作"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#102033",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": false,
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:devSessionCanvas.__internal.centerAttentionNode",
    "onWebviewPanel:devSessionCanvas.canvas"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted.description%",
      "restrictedConfigurations": [
        "devSessionCanvas.runtimePersistence.enabled",
        "devSessionCanvas.agent.defaultProvider",
        "devSessionCanvas.agent.codexCommand",
        "devSessionCanvas.agent.claudeCommand",
        "devSessionCanvas.agent.codexDefaultArgs",
        "devSessionCanvas.agent.claudeDefaultArgs",
        "devSessionCanvas.terminal.shell",
        "devSessionCanvas.terminal.shellPath",
        "devSessionCanvas.terminal.inheritEnv",
        "devSessionCanvas.terminal.shellArgs"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual.description%"
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devSessionCanvas",
          "title": "%viewsContainer.canvas.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "devSessionCanvasPanel",
          "title": "%viewsContainer.canvasPanel.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        }
      ]
    },
    "views": {
      "devSessionCanvas": [
        {
          "id": "devSessionCanvas.sidebar",
          "name": "%view.canvas.sidebar.summary.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        },
        {
          "id": "devSessionCanvas.sidebarTemplates",
          "name": "%view.canvas.sidebar.templates.title%",
          "icon": "images/dev-session-canvas-templates-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarFilters",
          "name": "%view.canvas.sidebar.actions.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarNodes",
          "name": "%view.canvas.sidebar.nodes.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarSessions",
          "name": "%view.canvas.sidebar.sessions.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        }
      ],
      "devSessionCanvasPanel": [
        {
          "type": "webview",
          "id": "devSessionCanvas.canvasPanel",
          "name": "%view.canvas.panel.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "when": "devSessionCanvas.canvas.panelViewVisible"
        }
      ]
    },
    "commands": [
      {
        "command": "devSessionCanvas.openCanvas",
        "title": "%command.openCanvas.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.openCanvasInEditor",
        "title": "%command.openCanvasInEditor.title%"
      },
      {
        "command": "devSessionCanvas.openCanvasInPanel",
        "title": "%command.openCanvasInPanel.title%"
      },
      {
        "command": "devSessionCanvas.openSettings",
        "title": "%command.openSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devSessionCanvas.selectTerminalShell",
        "title": "%command.selectTerminalShell.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.selectCodexCli",
        "title": "%command.selectCodexCli.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.selectClaudeCli",
        "title": "%command.selectClaudeCli.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.openCodexConfigFile",
        "title": "%command.openCodexConfigFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.openCodexAuthFile",
        "title": "%command.openCodexAuthFile.title%",
        "icon": "$(key)"
      },
      {
        "command": "devSessionCanvas.openClaudeSettingsFile",
        "title": "%command.openClaudeSettingsFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.createNode",
        "title": "%command.createNode.title%",
        "icon": "$(add)"
      },
      {
        "command": "devSessionCanvas.showNodeList",
        "title": "%command.showNodeList.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "devSessionCanvas.showSessionHistory",
        "title": "%command.showSessionHistory.title%",
        "icon": "$(history)"
      },
      {
        "command": "devSessionCanvas.refreshSessionHistory",
        "title": "%command.refreshSessionHistory.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "devSessionCanvas.resetCanvasState",
        "title": "%command.resetCanvasState.title%",
        "icon": "$(discard)"
      },
      {
        "command": "devSessionCanvas.dumpHostDiagnostics",
        "title": "%command.dumpHostDiagnostics.title%",
        "icon": "$(output)"
      },
      {
        "command": "devSessionCanvas.applyTemplate",
        "title": "%command.applyTemplate.title%",
        "icon": "$(run)"
      },
      {
        "command": "devSessionCanvas.applyDefaultTemplate",
        "title": "%command.applyDefaultTemplate.title%",
        "icon": "$(library)"
      },
      {
        "command": "devSessionCanvas.resetToDefaultTemplate",
        "title": "%command.resetToDefaultTemplate.title%",
        "icon": "$(discard)"
      },
      {
        "command": "devSessionCanvas.saveCanvasAsTemplate",
        "title": "%command.saveCanvasAsTemplate.title%",
        "icon": "$(save-as)"
      },
      {
        "command": "devSessionCanvas.importTemplate",
        "title": "%command.importTemplate.title%",
        "icon": "$(add)"
      },
      {
        "command": "devSessionCanvas.exportTemplate",
        "title": "%command.exportTemplate.title%",
        "icon": "$(export)"
      },
      {
        "command": "devSessionCanvas.deleteTemplate",
        "title": "%command.deleteTemplate.title%",
        "icon": "$(trash)"
      },
      {
        "command": "devSessionCanvas.setDefaultTemplate",
        "title": "%command.setDefaultTemplate.title%",
        "icon": "$(star-empty)"
      },
      {
        "command": "devSessionCanvas.refreshTemplates",
        "title": "%command.refreshTemplates.title%",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devSessionCanvas.openCanvas",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.openSettings",
          "when": "view == devSessionCanvas.sidebar",
          "group": "navigation@99"
        },
        {
          "command": "devSessionCanvas.refreshSessionHistory",
          "when": "view == devSessionCanvas.sidebarSessions",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.createNode",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@2"
        },
        {
          "command": "devSessionCanvas.resetCanvasState",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@3"
        },
        {
          "command": "devSessionCanvas.refreshTemplates",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.importTemplate",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@2"
        },
        {
          "command": "devSessionCanvas.saveCanvasAsTemplate",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "devSessionCanvas.openCodexAuthFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == codexCliConfig",
          "group": "inline@1"
        },
        {
          "command": "devSessionCanvas.openCodexConfigFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == codexCliConfig",
          "group": "inline@2"
        },
        {
          "command": "devSessionCanvas.openClaudeSettingsFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == claudeCliConfig",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "devSessionCanvas.canvas.defaultSurface": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "panel",
          "scope": "window",
          "markdownDescription": "%configuration.canvas.defaultSurface.description%"
        },
        "devSessionCanvas.runtimePersistence.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%configuration.runtimePersistence.enabled.description%"
        },
        "devSessionCanvas.agent.defaultProvider": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "codex",
          "scope": "window",
          "markdownDescription": "%configuration.agent.defaultProvider.description%"
        },
        "devSessionCanvas.agent.codexCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "markdownDescription": "%configuration.agent.codexCommand.description%"
        },
        "devSessionCanvas.agent.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "markdownDescription": "%configuration.agent.claudeCommand.description%"
        },
        "devSessionCanvas.agent.codexDefaultArgs": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.agent.codexDefaultArgs.description%"
        },
        "devSessionCanvas.agent.claudeDefaultArgs": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.agent.claudeDefaultArgs.description%"
        },
        "devSessionCanvas.notifications.attentionSignalBridge": {
          "type": "string",
          "enum": [
            "none",
            "workbench",
            "system"
          ],
          "enumItemLabels": [
            "%configuration.notifications.attentionSignalBridge.none.label%",
            "%configuration.notifications.attentionSignalBridge.workbench.label%",
            "%configuration.notifications.attentionSignalBridge.system.label%"
          ],
          "default": "system",
          "scope": "window",
          "markdownDescription": "%configuration.notifications.attentionSignalBridge.description%",
          "markdownEnumDescriptions": [
            "%configuration.notifications.attentionSignalBridge.none.description%",
            "%configuration.notifications.attentionSignalBridge.workbench.description%",
            "%configuration.notifications.attentionSignalBridge.system.description%"
          ]
        },
        "devSessionCanvas.notifications.strongTerminalAttentionReminder": {
          "type": "string",
          "enum": [
            "none",
            "titleBar",
            "minimap",
            "both"
          ],
          "default": "both",
          "scope": "window",
          "markdownDescription": "%configuration.notifications.strongTerminalAttentionReminder.description%",
          "markdownEnumDescriptions": [
            "%configuration.notifications.strongTerminalAttentionReminder.none.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.titleBar.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.minimap.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.both.description%"
          ]
        },
        "devSessionCanvas.terminal.shell": {
          "type": "string",
          "enum": [
            "default",
            "bash",
            "zsh",
            "fish",
            "sh",
            "pwsh",
            "powershell",
            "cmd"
          ],
          "default": "default",
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shell.description%",
          "markdownEnumDescriptions": [
            "%configuration.terminal.shell.default.description%",
            "%configuration.terminal.shell.bash.description%",
            "%configuration.terminal.shell.zsh.description%",
            "%configuration.terminal.shell.fish.description%",
            "%configuration.terminal.shell.sh.description%",
            "%configuration.terminal.shell.pwsh.description%",
            "%configuration.terminal.shell.powershell.description%",
            "%configuration.terminal.shell.cmd.description%"
          ]
        },
        "devSessionCanvas.terminal.shellPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shellPath.description%"
        },
        "devSessionCanvas.terminal.inheritEnv": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.inheritEnv.description%"
        },
        "devSessionCanvas.terminal.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shellArgs.description%"
        },
        "devSessionCanvas.files.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%configuration.files.enabled.description%"
        },
        "devSessionCanvas.files.presentationMode": {
          "type": "string",
          "enum": [
            "nodes",
            "lists"
          ],
          "default": "lists",
          "scope": "window",
          "markdownDescription": "%configuration.files.presentationMode.description%"
        },
        "devSessionCanvas.fileNode.displayStyle": {
          "type": "string",
          "enum": [
            "card",
            "minimal"
          ],
          "default": "minimal",
          "scope": "window",
          "markdownDescription": "%configuration.fileNode.displayStyle.description%"
        },
        "devSessionCanvas.files.nodeDisplayMode": {
          "type": "string",
          "enum": [
            "icon-path",
            "icon-only",
            "path-only"
          ],
          "default": "icon-path",
          "scope": "window",
          "markdownDescription": "%configuration.files.nodeDisplayMode.description%"
        },
        "devSessionCanvas.files.pathDisplayMode": {
          "type": "string",
          "enum": [
            "basename",
            "relative-path"
          ],
          "default": "basename",
          "scope": "window",
          "markdownDescription": "%configuration.files.pathDisplayMode.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:notifier": "npm run -w extensions/vscode/dev-session-canvas-notifier build",
    "package": "npm run typecheck && node scripts/build.mjs --production",
    "package:vsix": "npm run package && node scripts/package-vsix.mjs",
    "postinstall": "node scripts/ensure-node-pty-helper-permissions.mjs",
    "test": "npm run typecheck && npm run test:workspace-relative-paths && npm run test:extension-storage-paths && npm run test:runtime-supervisor-paths && npm run test:agent-cli-resolver && npm run test:agent-cli-selection && npm run test:agent-settings-files && npm run test:shell-environment-resolver && npm run test:execution-session-bridge && npm run test:package-vsix-command && npm run test:sidebar-codicon-bundle && npm run test:note-markdown-links && npm run test:note-body-indent && npm run test:note-markdown-checklists && npm run test:execution-terminal-native-helpers && npm run test:terminal-shell-configuration && npm run test:execution-terminal-line-context-tracker && npm run test:execution-attention-signals && npm run test:execution-terminal-clipboard && npm run test:agent-launch-presets && npm run test:canvas-templates && npm run test:sidebar-session-history && npm run test:attention-protocol && npm run test:notifier-source && npm run test:debug-launch-config && npm run test:smoke && npm run test:webview",
    "test:agent-cli-resolver": "node scripts/test-agent-cli-resolver.mjs",
    "test:agent-cli-selection": "node scripts/test-agent-cli-selection.mjs",
    "test:agent-settings-files": "node scripts/test-agent-settings-files.mjs",
    "test:agent-launch-presets": "node scripts/test-agent-launch-presets.mjs",
    "test:canvas-templates": "node scripts/test-canvas-templates.mjs",
    "test:shell-environment-resolver": "node scripts/test-shell-environment-resolver.mjs",
    "test:extension-storage-paths": "node scripts/test-extension-storage-paths.mjs",
    "test:execution-session-bridge": "node scripts/test-execution-session-bridge.mjs",
    "test:attention-protocol": "node --no-warnings --experimental-transform-types packages/attention-protocol/tests/attention-protocol.test.mts",
    "prepare:debug-main-only-extension": "node scripts/prepare-debug-main-only-extension.mjs",
    "test:debug-launch-config": "node scripts/test-debug-launch-config.mjs",
    "test:notifier-source": "node --no-warnings --experimental-transform-types extensions/vscode/dev-session-canvas-notifier/tests/platformNotification.test.mts",
    "test:notifier-smoke": "npm run build && npm run build:notifier && node scripts/run-vscode-notifier-smoke.mjs",
    "test:note-body-indent": "node --no-warnings --experimental-transform-types scripts/test-note-body-indent.mts",
    "test:note-markdown-links": "node --no-warnings --experimental-transform-types scripts/test-note-markdown-links.mts",
    "test:note-markdown-checklists": "node --no-warnings --experimental-transform-types scripts/test-note-markdown-checklists.mts",
    "test:package-vsix-command": "node scripts/test-package-vsix-command.mjs",
    "test:sidebar-codicon-bundle": "node scripts/test-sidebar-codicon-bundle.mjs",
    "test:execution-attention-signals": "node scripts/test-execution-attention-signals.mjs",
    "test:execution-terminal-clipboard": "node --no-warnings --experimental-transform-types scripts/test-execution-terminal-clipboard.mts",
    "test:execution-terminal-line-context-tracker": "node scripts/test-execution-terminal-line-context-tracker.mjs",
    "test:execution-terminal-native-helpers": "node scripts/test-execution-terminal-native-helpers.mjs",
    "test:terminal-shell-configuration": "node scripts/test-terminal-shell-configuration.mjs",
    "test:runtime-supervisor-paths": "node scripts/test-runtime-supervisor-paths.mjs",
    "test:sidebar-session-history": "node scripts/test-sidebar-session-history.mjs",
    "test:workspace-relative-paths": "node --no-warnings --experimental-transform-types scripts/test-workspace-relative-paths.mts",
    "test:vscode-smoke-runner-env": "node scripts/test-vscode-smoke-runner-env.mjs",
    "test:smoke": "npm run build && npm run build:notifier && node scripts/run-vscode-smoke.mjs",
    "test:smoke:windows-real-codex": "npm run build && npm run build:notifier && node scripts/run-windows-real-codex-smoke.mjs",
    "test:smoke-storage-slot": "npm run build && npm run build:notifier && node scripts/run-vscode-storage-slot-smoke.mjs",
    "validate:clean-checkout:vsix": "node scripts/run-clean-checkout-vsix-validation.mjs",
    "test:vsix-smoke": "node scripts/run-vscode-vsix-smoke.mjs",
    "test:webview": "npm run build && node scripts/run-playwright-webview.mjs",
    "generate:marketplace-media": "node scripts/generate-marketplace-media.mjs",
    "recording:start": "node scripts/recording-session.mjs start",
    "recording:stop": "node scripts/recording-session.mjs stop",
    "vscode:prepublish": "npm run package",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:notifier": "npm run -w extensions/vscode/dev-session-canvas-notifier typecheck"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "linkify-it": "^5.0.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "node-pty": "^1.2.0-beta.12",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reactflow": "11.11.4"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^18.19.80",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "cheerio": "1.0.0-rc.12",
    "esbuild": "^0.25.12",
    "typescript": "5.0.4"
  },
  "api": "none",
  "extensionPack": [
    "devsessioncanvas.dev-session-canvas-notifier"
  ]
}
