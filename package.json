{
  "name": "dev-session-canvas",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.10.5",
  "workspaces": [
    "extensions/vscode/dev-session-canvas-notifier",
    "packages/attention-protocol",
    "apps/template-marketplace",
    "packages/marketplace-shared"
  ],
  "publisher": "devsessioncanvas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas.git"
  },
  "homepage": "https://github.com/ZY-WANG-0304/dev-session-canvas",
  "bugs": {
    "url": "https://github.com/ZY-WANG-0304/dev-session-canvas/issues"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "canvas",
    "workbench",
    "multi-agent",
    "terminal",
    "note",
    "collaboration",
    "画布",
    "协作"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#102033",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": false,
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onUri",
    "onCommand:devSessionCanvas.openCanvas",
    "onCommand:devSessionCanvas.openCanvasInEditor",
    "onCommand:devSessionCanvas.openCanvasInPanel",
    "onCommand:devSessionCanvas.openSettings",
    "onCommand:devSessionCanvas.selectTerminalShell",
    "onCommand:devSessionCanvas.selectCodexCli",
    "onCommand:devSessionCanvas.selectClaudeCli",
    "onCommand:devSessionCanvas.openCodexConfigFile",
    "onCommand:devSessionCanvas.openCodexAuthFile",
    "onCommand:devSessionCanvas.openClaudeSettingsFile",
    "onCommand:devSessionCanvas.createNode",
    "onCommand:devSessionCanvas.showNodeList",
    "onCommand:devSessionCanvas.showSessionHistory",
    "onCommand:devSessionCanvas.refreshSessionHistory",
    "onCommand:devSessionCanvas.resetCanvasState",
    "onCommand:devSessionCanvas.dumpHostDiagnostics",
    "onCommand:devSessionCanvas.__internal.centerAttentionNode",
    "onView:devSessionCanvas.sidebar",
    "onView:devSessionCanvas.sidebarFilters",
    "onView:devSessionCanvas.sidebarNodes",
    "onView:devSessionCanvas.sidebarSessions",
    "onView:devSessionCanvas.canvasPanel",
    "onWebviewPanel:devSessionCanvas.canvas",
    "onCommand:devSessionCanvas.applyTemplate",
    "onCommand:devSessionCanvas.applyDefaultTemplate",
    "onCommand:devSessionCanvas.resetToDefaultTemplate",
    "onCommand:devSessionCanvas.saveCanvasAsTemplate",
    "onCommand:devSessionCanvas.openTemplateMarketplace",
    "onCommand:devSessionCanvas.publishTemplateToMarketplace",
    "onCommand:devSessionCanvas.importTemplate",
    "onCommand:devSessionCanvas.exportTemplate",
    "onCommand:devSessionCanvas.deleteTemplate",
    "onCommand:devSessionCanvas.setDefaultTemplate",
    "onCommand:devSessionCanvas.refreshTemplates",
    "onView:devSessionCanvas.sidebarTemplates"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted.description%",
      "restrictedConfigurations": [
        "devSessionCanvas.runtimePersistence.enabled",
        "devSessionCanvas.agent.defaultProvider",
        "devSessionCanvas.agent.codexCommand",
        "devSessionCanvas.agent.claudeCommand",
        "devSessionCanvas.agent.codexDefaultArgs",
        "devSessionCanvas.agent.claudeDefaultArgs",
        "devSessionCanvas.terminal.shell",
        "devSessionCanvas.terminal.shellPath",
        "devSessionCanvas.terminal.inheritEnv",
        "devSessionCanvas.terminal.shellArgs"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual.description%"
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devSessionCanvas",
          "title": "%viewsContainer.canvas.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        }
      ],
      "panel": [
        {
          "id": "devSessionCanvasPanel",
          "title": "%viewsContainer.canvasPanel.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        }
      ]
    },
    "views": {
      "devSessionCanvas": [
        {
          "id": "devSessionCanvas.sidebar",
          "name": "%view.canvas.sidebar.summary.title%",
          "icon": "images/dev-session-canvas-activitybar.svg"
        },
        {
          "id": "devSessionCanvas.sidebarTemplates",
          "name": "%view.canvas.sidebar.templates.title%",
          "icon": "images/dev-session-canvas-templates-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarFilters",
          "name": "%view.canvas.sidebar.actions.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarNodes",
          "name": "%view.canvas.sidebar.nodes.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        },
        {
          "id": "devSessionCanvas.sidebarSessions",
          "name": "%view.canvas.sidebar.sessions.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "type": "webview"
        }
      ],
      "devSessionCanvasPanel": [
        {
          "type": "webview",
          "id": "devSessionCanvas.canvasPanel",
          "name": "%view.canvas.panel.title%",
          "icon": "images/dev-session-canvas-activitybar.svg",
          "when": "devSessionCanvas.canvas.panelViewVisible"
        }
      ]
    },
    "commands": [
      {
        "command": "devSessionCanvas.openCanvas",
        "title": "%command.openCanvas.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.openCanvasInEditor",
        "title": "%command.openCanvasInEditor.title%"
      },
      {
        "command": "devSessionCanvas.openCanvasInPanel",
        "title": "%command.openCanvasInPanel.title%"
      },
      {
        "command": "devSessionCanvas.openSettings",
        "title": "%command.openSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devSessionCanvas.selectTerminalShell",
        "title": "%command.selectTerminalShell.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.selectCodexCli",
        "title": "%command.selectCodexCli.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.selectClaudeCli",
        "title": "%command.selectClaudeCli.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "devSessionCanvas.openCodexConfigFile",
        "title": "%command.openCodexConfigFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.openCodexAuthFile",
        "title": "%command.openCodexAuthFile.title%",
        "icon": "$(key)"
      },
      {
        "command": "devSessionCanvas.openClaudeSettingsFile",
        "title": "%command.openClaudeSettingsFile.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devSessionCanvas.createNode",
        "title": "%command.createNode.title%",
        "icon": "$(add)"
      },
      {
        "command": "devSessionCanvas.showNodeList",
        "title": "%command.showNodeList.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "devSessionCanvas.showSessionHistory",
        "title": "%command.showSessionHistory.title%",
        "icon": "$(history)"
      },
      {
        "command": "devSessionCanvas.refreshSessionHistory",
        "title": "%command.refreshSessionHistory.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "devSessionCanvas.resetCanvasState",
        "title": "%command.resetCanvasState.title%",
        "icon": "$(discard)"
      },
      {
        "command": "devSessionCanvas.dumpHostDiagnostics",
        "title": "%command.dumpHostDiagnostics.title%",
        "icon": "$(output)"
      },
      {
        "command": "devSessionCanvas.applyTemplate",
        "title": "%command.applyTemplate.title%",
        "icon": "$(run)"
      },
      {
        "command": "devSessionCanvas.applyDefaultTemplate",
        "title": "%command.applyDefaultTemplate.title%",
        "icon": "$(library)"
      },
      {
        "command": "devSessionCanvas.resetToDefaultTemplate",
        "title": "%command.resetToDefaultTemplate.title%",
        "icon": "$(discard)"
      },
      {
        "command": "devSessionCanvas.saveCanvasAsTemplate",
        "title": "%command.saveCanvasAsTemplate.title%",
        "icon": "$(save-as)"
      },
      {
        "command": "devSessionCanvas.openTemplateMarketplace",
        "title": "%command.openTemplateMarketplace.title%",
        "icon": "$(globe)"
      },
      {
        "command": "devSessionCanvas.publishTemplateToMarketplace",
        "title": "%command.publishTemplateToMarketplace.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "devSessionCanvas.importTemplate",
        "title": "%command.importTemplate.title%",
        "icon": "$(add)"
      },
      {
        "command": "devSessionCanvas.exportTemplate",
        "title": "%command.exportTemplate.title%",
        "icon": "$(export)"
      },
      {
        "command": "devSessionCanvas.deleteTemplate",
        "title": "%command.deleteTemplate.title%",
        "icon": "$(trash)"
      },
      {
        "command": "devSessionCanvas.setDefaultTemplate",
        "title": "%command.setDefaultTemplate.title%",
        "icon": "$(star-empty)"
      },
      {
        "command": "devSessionCanvas.refreshTemplates",
        "title": "%command.refreshTemplates.title%",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devSessionCanvas.openCanvas",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.openSettings",
          "when": "view == devSessionCanvas.sidebar",
          "group": "navigation@99"
        },
        {
          "command": "devSessionCanvas.refreshSessionHistory",
          "when": "view == devSessionCanvas.sidebarSessions",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.createNode",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@2"
        },
        {
          "command": "devSessionCanvas.resetCanvasState",
          "when": "view == devSessionCanvas.sidebarFilters",
          "group": "navigation@3"
        },
        {
          "command": "devSessionCanvas.refreshTemplates",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@1"
        },
        {
          "command": "devSessionCanvas.openTemplateMarketplace",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@2"
        },
        {
          "command": "devSessionCanvas.importTemplate",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@3"
        },
        {
          "command": "devSessionCanvas.saveCanvasAsTemplate",
          "when": "view == devSessionCanvas.sidebarTemplates",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "devSessionCanvas.openCodexAuthFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == codexCliConfig",
          "group": "inline@1"
        },
        {
          "command": "devSessionCanvas.openCodexConfigFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == codexCliConfig",
          "group": "inline@2"
        },
        {
          "command": "devSessionCanvas.openClaudeSettingsFile",
          "when": "view == devSessionCanvas.sidebar && viewItem == claudeCliConfig",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "devSessionCanvas.canvas.defaultSurface": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "panel",
          "scope": "window",
          "markdownDescription": "%configuration.canvas.defaultSurface.description%"
        },
        "devSessionCanvas.canvas.overviewMode": {
          "type": "string",
          "enum": [
            "none",
            "title"
          ],
          "enumItemLabels": [
            "%configuration.canvas.overviewMode.none.label%",
            "%configuration.canvas.overviewMode.title.label%"
          ],
          "default": "title",
          "scope": "window",
          "markdownDescription": "%configuration.canvas.overviewMode.description%",
          "markdownEnumDescriptions": [
            "%configuration.canvas.overviewMode.none.description%",
            "%configuration.canvas.overviewMode.title.description%"
          ]
        },
        "devSessionCanvas.canvas.overviewZoomThreshold": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "scope": "window",
          "markdownDescription": "%configuration.canvas.overviewZoomThreshold.description%"
        },
        "devSessionCanvas.runtimePersistence.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%configuration.runtimePersistence.enabled.description%"
        },
        "devSessionCanvas.agent.defaultProvider": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "codex",
          "scope": "window",
          "markdownDescription": "%configuration.agent.defaultProvider.description%"
        },
        "devSessionCanvas.agent.codexCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "markdownDescription": "%configuration.agent.codexCommand.description%"
        },
        "devSessionCanvas.agent.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "markdownDescription": "%configuration.agent.claudeCommand.description%"
        },
        "devSessionCanvas.agent.codexDefaultArgs": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.agent.codexDefaultArgs.description%"
        },
        "devSessionCanvas.agent.claudeDefaultArgs": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.agent.claudeDefaultArgs.description%"
        },
        "devSessionCanvas.notifications.attentionSignalBridge": {
          "type": "string",
          "enum": [
            "none",
            "workbench",
            "system"
          ],
          "enumItemLabels": [
            "%configuration.notifications.attentionSignalBridge.none.label%",
            "%configuration.notifications.attentionSignalBridge.workbench.label%",
            "%configuration.notifications.attentionSignalBridge.system.label%"
          ],
          "default": "system",
          "scope": "window",
          "markdownDescription": "%configuration.notifications.attentionSignalBridge.description%",
          "markdownEnumDescriptions": [
            "%configuration.notifications.attentionSignalBridge.none.description%",
            "%configuration.notifications.attentionSignalBridge.workbench.description%",
            "%configuration.notifications.attentionSignalBridge.system.description%"
          ]
        },
        "devSessionCanvas.notifications.strongTerminalAttentionReminder": {
          "type": "string",
          "enum": [
            "none",
            "titleBar",
            "minimap",
            "both"
          ],
          "default": "both",
          "scope": "window",
          "markdownDescription": "%configuration.notifications.strongTerminalAttentionReminder.description%",
          "markdownEnumDescriptions": [
            "%configuration.notifications.strongTerminalAttentionReminder.none.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.titleBar.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.minimap.description%",
            "%configuration.notifications.strongTerminalAttentionReminder.both.description%"
          ]
        },
        "devSessionCanvas.terminal.shell": {
          "type": "string",
          "enum": [
            "default",
            "bash",
            "zsh",
            "fish",
            "sh",
            "pwsh",
            "powershell",
            "cmd"
          ],
          "default": "default",
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shell.description%",
          "markdownEnumDescriptions": [
            "%configuration.terminal.shell.default.description%",
            "%configuration.terminal.shell.bash.description%",
            "%configuration.terminal.shell.zsh.description%",
            "%configuration.terminal.shell.fish.description%",
            "%configuration.terminal.shell.sh.description%",
            "%configuration.terminal.shell.pwsh.description%",
            "%configuration.terminal.shell.powershell.description%",
            "%configuration.terminal.shell.cmd.description%"
          ]
        },
        "devSessionCanvas.terminal.shellPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shellPath.description%"
        },
        "devSessionCanvas.terminal.inheritEnv": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.inheritEnv.description%"
        },
        "devSessionCanvas.terminal.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "%configuration.terminal.shellArgs.description%"
        },
        "devSessionCanvas.files.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%configuration.files.enabled.description%"
        },
        "devSessionCanvas.files.presentationMode": {
          "type": "string",
          "enum": [
            "nodes",
            "lists"
          ],
          "default": "lists",
          "scope": "window",
          "markdownDescription": "%configuration.files.presentationMode.description%"
        },
        "devSessionCanvas.fileNode.displayStyle": {
          "type": "string",
          "enum": [
            "card",
            "minimal"
          ],
          "default": "minimal",
          "scope": "window",
          "markdownDescription": "%configuration.fileNode.displayStyle.description%"
        },
        "devSessionCanvas.files.nodeDisplayMode": {
          "type": "string",
          "enum": [
            "icon-path",
            "icon-only",
            "path-only"
          ],
          "default": "icon-path",
          "scope": "window",
          "markdownDescription": "%configuration.files.nodeDisplayMode.description%"
        },
        "devSessionCanvas.files.pathDisplayMode": {
          "type": "string",
          "enum": [
            "basename",
            "relative-path"
          ],
          "default": "basename",
          "scope": "window",
          "markdownDescription": "%configuration.files.pathDisplayMode.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build/build.mjs",
    "build:notifier": "npm run -w extensions/vscode/dev-session-canvas-notifier build",
    "package": "npm run typecheck && node scripts/build/build.mjs --production",
    "package:vsix": "npm run package && node scripts/release/package-vsix.mjs",
    "postinstall": "node scripts/shared/ensure-node-pty-helper-permissions.mjs",
    "test": "npm run typecheck && npm run test:marketplace && npm run test:workspace-relative-paths && npm run test:extension-storage-paths && npm run test:runtime-supervisor-paths && npm run test:runtime-supervisor-protocol && npm run test:protocol-webview-messages && npm run test:agent-cli-resolver && npm run test:agent-cli-selection && npm run test:agent-settings-files && npm run test:shell-environment-resolver && npm run test:execution-session-bridge && npm run test:extension-manifest && npm run test:package-vsix-command && npm run test:package-vsix-file-list && npm run test:publish-marketplaces && npm run test:sidebar-codicon-bundle && npm run test:sidebar-list-colors && npm run test:theme-color-tokens && npm run test:activitybar-badges && npm run test:avatar && npm run test:note-markdown-links && npm run test:note-markdown-source-map && npm run test:note-markdown-file-association && npm run test:note-body-indent && npm run test:note-markdown-checklists && npm run test:note-markdown-front-matter && npm run test:execution-terminal-links && npm run test:execution-terminal-native-helpers && npm run test:terminal-shell-configuration && npm run test:execution-terminal-line-context-tracker && npm run test:execution-attention-signals && npm run test:execution-terminal-clipboard && npm run test:agent-launch-presets && npm run test:canvas-templates && npm run test:sidebar-session-history && npm run test:attention-protocol && npm run test:notifier-source && npm run test:debug-launch-config && npm run test:smoke && npm run test:webview",
    "test:agent-cli-resolver": "node scripts/test/test-agent-cli-resolver.mjs",
    "test:agent-cli-selection": "node scripts/test/test-agent-cli-selection.mjs",
    "test:agent-settings-files": "node scripts/test/test-agent-settings-files.mjs",
    "test:agent-launch-presets": "node scripts/test/test-agent-launch-presets.mjs",
    "test:canvas-templates": "node scripts/test/test-canvas-templates.mjs",
    "test:shell-environment-resolver": "node scripts/test/test-shell-environment-resolver.mjs",
    "test:extension-storage-paths": "node scripts/test/test-extension-storage-paths.mjs",
    "test:execution-session-bridge": "node scripts/test/test-execution-session-bridge.mjs",
    "test:attention-protocol": "node --no-warnings --experimental-transform-types packages/attention-protocol/tests/attention-protocol.test.mts",
    "prepare:debug-main-only-extension": "node scripts/shared/prepare-debug-main-only-extension.mjs",
    "test:debug-launch-config": "node scripts/test/test-debug-launch-config.mjs",
    "test:notifier-source": "node --no-warnings --experimental-transform-types extensions/vscode/dev-session-canvas-notifier/tests/platformNotification.test.mts && node --no-warnings --experimental-transform-types extensions/vscode/dev-session-canvas-notifier/tests/sidebarRichText.test.mts && node --no-warnings --experimental-transform-types extensions/vscode/dev-session-canvas-notifier/tests/sidebarStatus.test.mts && node --no-warnings --experimental-transform-types extensions/vscode/dev-session-canvas-notifier/tests/sidebarViewSource.test.mts",
    "test:notifier-smoke": "npm run build && npm run build:notifier && node scripts/smoke/run-vscode-notifier-smoke.mjs",
    "test:note-body-indent": "node --no-warnings --experimental-transform-types scripts/test/test-note-body-indent.mts",
    "test:note-markdown-links": "node --no-warnings --experimental-transform-types scripts/test/test-note-markdown-links.mts",
    "test:note-markdown-source-map": "node --no-warnings --experimental-transform-types scripts/test/test-note-markdown-source-map.mts",
    "test:note-markdown-file-association": "node --no-warnings --experimental-transform-types scripts/test/test-note-markdown-file-association.mts",
    "test:note-markdown-checklists": "node --no-warnings --experimental-transform-types scripts/test/test-note-markdown-checklists.mts",
    "test:note-markdown-front-matter": "node --no-warnings --experimental-transform-types scripts/test/test-note-markdown-front-matter.mts",
    "test:package-vsix-command": "node scripts/test/test-package-vsix-command.mjs",
    "test:sidebar-codicon-bundle": "node scripts/test/test-sidebar-codicon-bundle.mjs",
    "test:sidebar-list-colors": "node scripts/test/test-sidebar-list-color-tokens.mjs",
    "test:theme-color-tokens": "node scripts/test/test-theme-color-tokens.mjs && node --no-warnings --experimental-transform-types scripts/test/test-canvas-node-status-presentation.mts",
    "test:activitybar-badges": "node scripts/test/run-playwright-node.mjs scripts/test/test-activitybar-badge-geometry.mjs",
    "test:avatar": "node scripts/test/run-playwright-node.mjs scripts/test/test-avatar-safe-area.mjs",
    "test:execution-attention-signals": "node scripts/test/test-execution-attention-signals.mjs",
    "test:execution-terminal-clipboard": "node --no-warnings --experimental-transform-types scripts/test/test-execution-terminal-clipboard.mts",
    "test:execution-terminal-links": "node --no-warnings --experimental-transform-types scripts/test/test-execution-terminal-links.mts",
    "test:execution-terminal-line-context-tracker": "node scripts/test/test-execution-terminal-line-context-tracker.mjs",
    "test:execution-terminal-native-helpers": "node scripts/test/test-execution-terminal-native-helpers.mjs",
    "test:terminal-shell-configuration": "node scripts/test/test-terminal-shell-configuration.mjs",
    "test:runtime-supervisor-paths": "node scripts/test/test-runtime-supervisor-paths.mjs",
    "test:runtime-supervisor-protocol": "node scripts/test/test-runtime-supervisor-protocol.mjs",
    "test:protocol-webview-messages": "node --no-warnings --experimental-transform-types scripts/test/test-protocol-webview-messages.mts",
    "test:extension-manifest": "node scripts/test/test-extension-manifest.mjs",
    "test:sidebar-session-history": "node scripts/test/test-sidebar-session-history.mjs",
    "test:workspace-relative-paths": "node --no-warnings --experimental-transform-types scripts/test/test-workspace-relative-paths.mts",
    "test:vscode-smoke-runner-env": "node scripts/test/test-vscode-smoke-runner-env.mjs",
    "test:smoke": "npm run build && npm run build:notifier && node scripts/smoke/run-vscode-smoke.mjs",
