{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install dependencies",
      "type": "process",
      "command": "node",
      "args": ["scripts/shared/ensure-node-dependencies.mjs"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build extension",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "detail": "Default owned-provider build; requires matching execution assets.",
      "dependsOrder": "sequence",
      "dependsOn": ["install dependencies"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build extension (stock comparison)",
      "type": "process",
      "command": "npm",
      "args": ["run", "build", "--", "--execution-profile=stock"],
      "detail": "Explicit stock comparison build; not for formal runtime validation.",
      "dependsOrder": "sequence",
      "dependsOn": ["install dependencies"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build notifier",
      "type": "process",
      "command": "npm",
      "args": ["run", "build:notifier"],
      "dependsOrder": "sequence",
      "dependsOn": ["install dependencies"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build extension + notifier",
      "dependsOrder": "sequence",
      "dependsOn": ["build extension", "build notifier"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "prepare debug main-only extension",
      "type": "process",
      "command": "npm",
      "args": ["run", "prepare:debug-main-only-extension"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build debug main-only extension",
      "detail": "Default owned-provider main-only debug build.",
      "dependsOrder": "sequence",
      "dependsOn": ["build extension", "prepare debug main-only extension"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build debug main-only extension (stock comparison)",
      "detail": "Explicit stock comparison main-only debug build.",
      "dependsOrder": "sequence",
      "dependsOn": ["build extension (stock comparison)", "prepare debug main-only extension"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
