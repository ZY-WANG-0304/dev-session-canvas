{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dev Session Canvas (Main Only)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--profile=Dev Session Canvas Extension Debug",
        "--extensionDevelopmentPath=${workspaceFolder}/.debug/vscode-extension-main-only"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/.vscode-server/**/extensions/**",
        "**/.vscode-server/**/server/extensions/**",
        "**/resources/app/extensions/**"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/vscode/dev-session-canvas/dist/**/*.js",
        "${workspaceFolder}/.debug/vscode-extension-main-only/dist/**/*.js"
      ],
      "sourceMapPathOverrides": {
        "../src/*": "${workspaceFolder}/extensions/vscode/dev-session-canvas/src/*",
        "../../../../../packages/*": "${workspaceFolder}/packages/*",
        "../../../../../node_modules/*": "${workspaceFolder}/node_modules/*",
        "../../../node_modules/*": "${workspaceFolder}/node_modules/*"
      },
      "preLaunchTask": "build debug main-only extension"
    },
    {
      "name": "Run Dev Session Canvas + Notifier (Local Window)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--profile=Dev Session Canvas Notifier Extension Debug",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode/dev-session-canvas",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode/dev-session-canvas-notifier"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/.vscode-server/**/extensions/**",
        "**/.vscode-server/**/server/extensions/**",
        "**/resources/app/extensions/**"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/vscode/dev-session-canvas/dist/**/*.js",
        "${workspaceFolder}/extensions/vscode/dev-session-canvas-notifier/dist/**/*.js"
      ],
      "preLaunchTask": "build extension + notifier"
    },
    {
      "name": "Run Dev Session Canvas + Notifier (Remote Window)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--profile=Dev Session Canvas Notifier Extension Debug",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/vscode/dev-session-canvas",
        "--extensionDevelopmentPath=${input:devSessionCanvas.localRepoRoot}/extensions/vscode/dev-session-canvas-notifier"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/.vscode-server/**/extensions/**",
        "**/.vscode-server/**/server/extensions/**",
        "**/resources/app/extensions/**"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/vscode/dev-session-canvas/dist/**/*.js",
        "${input:devSessionCanvas.localRepoRoot}/extensions/vscode/dev-session-canvas-notifier/dist/**/*.js"
      ],
      "preLaunchTask": "build extension"
    }
  ],
  "inputs": [
    {
      "id": "devSessionCanvas.localRepoRoot",
      "type": "promptString",
      "description": "本机 repo 根目录绝对路径，例如 /Users/you/dev-session-canvas"
    }
  ]
}
