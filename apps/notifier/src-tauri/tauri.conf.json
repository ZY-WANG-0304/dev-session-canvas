{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSCanvas Notifier",
  "version": "0.0.1",
  "identifier": "io.github.zy-wang-0304.dsc.notifier",
  "build": {
    "beforeDevCommand": "npm run ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSCanvas Notifier",
        "width": 720,
        "height": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.png",
      "icons/notifier.icns"
    ]
  }
}
