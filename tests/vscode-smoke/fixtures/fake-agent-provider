#!/usr/bin/env bash

set -uo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"

mode="start"
if [[ "${1-}" == "resume" ]]; then
  mode="resume"
  shift
fi

requested_resume_session_id="${1-}"
session_dir="${DEV_SESSION_CANVAS_FAKE_PROVIDER_STORAGE_PATH:-}"
session_file=""
session_id=""
initial_prompt_delay_seconds="0.45"
hide_pid="${DEV_SESSION_CANVAS_FAKE_PROVIDER_HIDE_PID:-0}"
flavor="${DEV_SESSION_CANVAS_FAKE_AGENT_FLAVOR:-generic}"
stop_hint_style="${DEV_SESSION_CANVAS_FAKE_PROVIDER_STOP_HINT_STYLE:-$flavor}"
file_event_stream="${DEV_SESSION_CANVAS_FAKE_AGENT_FILE_EVENT_STREAM_PATH:-}"
claude_resume_requires_interaction="${DEV_SESSION_CANVAS_FAKE_CLAUDE_HINT_REQUIRES_INTERACTION:-1}"
claude_stop_requires_double_interrupt="${DEV_SESSION_CANVAS_FAKE_CLAUDE_STOP_REQUIRES_DOUBLE_INTERRUPT:-0}"
claude_exit_prompt_on_first_interrupt="${DEV_SESSION_CANVAS_FAKE_CLAUDE_EXIT_PROMPT_ON_FIRST_INTERRUPT:-0}"
claude_lifecycle_hooks="${DEV_SESSION_CANVAS_FAKE_CLAUDE_LIFECYCLE_HOOKS:-0}"
claude_lifecycle_settings=""
claude_cli_session_id=""
claude_prompt_sequence=0
claude_active_prompt_id=""
claude_session_confirmed=0
claude_interrupt_count=0

if [[ "$flavor" == "claude" && "$claude_lifecycle_hooks" == "1" ]]; then
  for ((argument_index = 1; argument_index <= $#; argument_index += 1)); do
    argument="${!argument_index}"
    if [[ "$argument" == "--settings" ]]; then
      value_index=$((argument_index + 1))
      claude_lifecycle_settings="${!value_index-}"
      argument_index=$value_index
    elif [[ "$argument" == --settings=* ]]; then
      claude_lifecycle_settings="${argument#--settings=}"
    elif [[ "$argument" == "--session-id" ]]; then
      value_index=$((argument_index + 1))
      claude_cli_session_id="${!value_index-}"
      argument_index=$value_index
    elif [[ "$argument" == --session-id=* ]]; then
      claude_cli_session_id="${argument#--session-id=}"
    fi
  done
fi

prefix="[fake-agent]"
if [[ "$flavor" == "codex" ]]; then
  prefix="[fake-codex]"
elif [[ "$flavor" == "claude" ]]; then
  prefix="[fake-claude]"
fi

default_session_id() {
  if [[ "$flavor" == "codex" ]]; then
    printf '019dbfb8-cffa-70b0-9c97-%012d' "$$"
    return
  fi

  printf 'session-%s' "$$"
}

if [[ -n "$session_dir" ]]; then
  mkdir -p "$session_dir"
  session_file="${session_dir%/}/last-session"
fi

if [[ "$mode" == "resume" ]]; then
  if [[ "$flavor" == "codex" && -z "$session_file" ]]; then
    if [[ -z "$requested_resume_session_id" ]]; then
      echo "${prefix} missing resume session id"
      exit 20
    fi

    session_id="$requested_resume_session_id"
    if [[ "$hide_pid" == "1" ]]; then
      echo "${prefix} resumed session ${session_id}"
    else
      echo "${prefix} resumed session ${session_id} pid=$$"
    fi
  else
    if [[ -z "$session_file" || ! -f "$session_file" ]]; then
      echo "${prefix} no resumable session"
      exit 19
    fi

    session_id="$(cat "$session_file")"
    if [[ -z "$requested_resume_session_id" ]]; then
      echo "${prefix} missing resume session id"
      exit 20
    fi
    if [[ "$requested_resume_session_id" != "$session_id" ]]; then
      echo "${prefix} resume session mismatch expected=${session_id} actual=${requested_resume_session_id}"
      exit 21
    fi
    if [[ "$hide_pid" == "1" ]]; then
      echo "${prefix} resumed session ${session_id}"
    else
      echo "${prefix} resumed session ${session_id} pid=$$"
    fi
  fi
else
  session_id="${DEV_SESSION_CANVAS_FAKE_PROVIDER_SESSION_ID:-${claude_cli_session_id:-$(default_session_id)}}"
  if [[ -n "$session_file" ]]; then
    printf '%s\n' "$session_id" > "$session_file"
  fi
  if [[ "$hide_pid" == "1" ]]; then
    echo "${prefix} ready session=${session_id}"
  else
    echo "${prefix} ready pid=$$ session=${session_id}"
  fi
fi

print_prompt() {
  printf '> '
}

emit_claude_lifecycle_hook() {
  local event_name="$1"
  local prompt_id="$2"
  local error_message="${3-}"

  if [[
    "$flavor" != "claude" ||
    "$claude_lifecycle_hooks" != "1" ||
    -z "$claude_lifecycle_settings" ||
    -z "$prompt_id"
  ]]; then
    return
  fi

  "${SCRIPT_DIR}/fake-claude-hook-runner.cjs" \
    "$claude_lifecycle_settings" \
    "$event_name" \
    "$session_id" \
    "$prompt_id" \
    "$error_message"
}

start_claude_turn() {
  claude_prompt_sequence=$((claude_prompt_sequence + 1))
  claude_active_prompt_id="prompt-${claude_prompt_sequence}"
  emit_claude_lifecycle_hook "UserPromptSubmit" "$claude_active_prompt_id"
}

complete_claude_turn() {
  emit_claude_lifecycle_hook "Stop" "$claude_active_prompt_id"
  claude_active_prompt_id=""
  print_prompt
}

normalize_event_path() {
  local candidate="$1"
  if [[ -z "$candidate" ]]; then
    return
  fi

  if command -v realpath >/dev/null 2>&1; then
    realpath -m "$candidate"
    return
  fi

  if [[ "$candidate" == /* ]]; then
    printf '%s\n' "$candidate"
    return
  fi

  printf '%s\n' "${PWD%/}/$candidate"
}

emit_file_event() {
  local access_mode="$1"
  local raw_path="$2"
  local normalized_path

  if [[ -z "$file_event_stream" || -z "$access_mode" || -z "$raw_path" ]]; then
    return
  fi

  normalized_path="$(normalize_event_path "$raw_path")"
  mkdir -p "$(dirname "$file_event_stream")"
  printf '{"path":"%s","accessMode":"%s","timestamp":"%s"}\n' \
    "${normalized_path//\"/\\\"}" \
    "$access_mode" \
    "$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")" >> "$file_event_stream"
}

sleep "$initial_prompt_delay_seconds"
print_prompt

handle_signal() {
  local signal_name="$1"
  if [[ "$stop_hint_style" == "codex" && "$signal_name" == "INT" ]]; then
    echo "Token usage: total=128 input=64 output=64"
    echo "To continue this session, run codex resume ${session_id}"
  elif [[ "$stop_hint_style" == "claude" && "$signal_name" == "INT" ]]; then
    claude_interrupt_count=$((claude_interrupt_count + 1))
    if [[ "$claude_stop_requires_double_interrupt" == "1" && "$claude_interrupt_count" -lt 2 ]]; then
      if [[ "$claude_exit_prompt_on_first_interrupt" == "1" ]]; then
        echo "Press Ctrl-C again to exit"
      fi
      return
    fi
    if [[ "$claude_resume_requires_interaction" != "1" || "$claude_session_confirmed" == "1" ]]; then
      echo "Resume this session with:"
      echo "claude --resume ${session_id}"
    fi
  fi
  echo "${prefix} received signal ${signal_name}"
  exit 0
}

trap 'handle_signal TERM' TERM
trap 'handle_signal INT' INT

while IFS= read -r line; do
  line="${line%$'\r'}"

  if [[ -z "$line" ]]; then
    continue
  fi

  if [[ "$flavor" == "claude" ]]; then
    claude_session_confirmed=1
    start_claude_turn
  fi

  if [[ "$line" == exit\ * ]]; then
    exit_code="${line#exit }"
    echo "${prefix} exiting with code ${exit_code}"
    exit "$exit_code"
  fi

  if [[ "$line" == failturn\ * ]]; then
    error_message="${line#failturn }"
    echo "${prefix} turn failed: ${error_message}"
    emit_claude_lifecycle_hook "StopFailure" "$claude_active_prompt_id" "$error_message"
    claude_active_prompt_id=""
    print_prompt
    continue
  fi

  if [[ "$line" == burst\ * ]]; then
    burst_count="${line#burst }"
    if [[ "$burst_count" =~ ^[0-9]+$ ]]; then
      for ((i = 1; i <= burst_count; i += 1)); do
        printf '%s burst %03d\n' "$prefix" "$i"
      done
      complete_claude_turn
      continue
    fi
  fi

  if [[ "$line" == read\ * ]]; then
    file_path="${line#read }"
    emit_file_event "read" "$file_path"
    echo "${prefix} read ${file_path}"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == readexit\ * ]]; then
    file_path="${line#readexit }"
    emit_file_event "read" "$file_path"
    exit 0
  fi

  if [[ "$line" == write\ * ]]; then
    file_path="${line#write }"
    emit_file_event "write" "$file_path"
    echo "${prefix} write ${file_path}"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == readwrite\ * ]]; then
    file_path="${line#readwrite }"
    emit_file_event "read-write" "$file_path"
    echo "${prefix} readwrite ${file_path}"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == sleep\ * ]]; then
    sleep_seconds="${line#sleep }"
    echo "${prefix} sleeping ${sleep_seconds}s"
    sleep "$sleep_seconds"
    echo "${prefix} woke after ${sleep_seconds}s"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == slowspin\ * ]]; then
    spin_count="${line#slowspin }"
    if [[ "$spin_count" =~ ^[0-9]+$ ]]; then
      frames=('-' '\\' '|' '/')
      for ((i = 1; i <= spin_count; i += 1)); do
        frame_index=$(((i - 1) % ${#frames[@]}))
        printf '\r%s %s slowspin %03d' "$prefix" "${frames[$frame_index]}" "$i"
        sleep 0.55
      done
      printf '\r%s slowspin done %03d\n' "$prefix" "$spin_count"
      complete_claude_turn
      continue
    fi
  fi

  if [[ "$line" == "写一首打油诗" ]]; then
    echo "小站灯昏代码香"
    sleep 0.12
    echo "键盘敲出半行霜"
    sleep 0.12
    echo "若问今晚谁最忙"
    sleep 0.12
    echo "Code Worker 一边写诗一边扛"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == clear-demo ]]; then
    printf '\033[2J\033[H'
    complete_claude_turn
    continue
  fi

  if [[ "$line" == raw\ * ]]; then
    printf '%s\n' "${line#raw }"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == notify\ * ]]; then
    notify_message="${line#notify }"
    printf '\033]9;%s\007' "$notify_message"
    printf '%s notified %s\n' "$prefix" "$notify_message"
    complete_claude_turn
    continue
  fi

  if [[ "$line" == bell\ * ]]; then
    bell_message="${line#bell }"
    printf '\007'
    printf '%s belled %s\n' "$prefix" "$bell_message"
    complete_claude_turn
    continue
  fi

  echo "${prefix} ${line}"
  complete_claude_turn
done
